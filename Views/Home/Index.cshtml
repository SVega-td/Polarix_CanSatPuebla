@{
    ViewData["Title"] = "Dashboard ASPIRAL";
    Layout = null; // Correcto: Ignoramos el layout por defecto para hacer un dashboard a pantalla completa
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ASPIRAL - Estación Terrena CANSAT</title>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <!-- SignalR (Solo una vez y en la versión correcta) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.10/signalr.min.js"></script>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <div class="container">
        <!-- HEADER -->
        <header class="header">
            <h1> ASPIRAL</h1>
            <div class="status-indicator">
                <span id="connectionStatus" style="font-size:13px; color:#7a8ba3;">Conectando...</span>
                <span class="led" id="statusLed"></span>
            </div>
            <div class="header-info">
                <span><strong>Misión:</strong> CANSAT TELEMETRIA</span>
                <span id="packetCounter"><strong>Paquetes:</strong> 0</span>
                <span id="lastUpdate"><strong>Última:</strong> --:--:--</span>
            </div>
        </header>

        <!-- MÉTRICAS EN TIEMPO REAL -->
        <section class="metrics-grid" id="metricsGrid">
            <div class="metric-card">
                <div class="label"> Temperatura</div>
                <div class="value temperature" id="tempValue">--</div>
                <div class="unit">°C</div>
            </div>
            <div class="metric-card">
                <div class="label"> Humedad</div>
                <div class="value humidity" id="humValue">--</div>
                <div class="unit">%</div>
            </div>
            <div class="metric-card">
                <div class="label"> Presión</div>
                <div class="value pressure" id="presValue">--</div>
                <div class="unit">Pa</div>
            </div>
            <div class="metric-card">
                <div class="label"> Altitud</div>
                <div class="value altitude" id="altValue">--</div>
                <div class="unit">m</div>
            </div>
            <div class="metric-card">
                <div class="label"> Velocidad</div>
                <div class="value speed" id="speedValue">--</div>
                <div class="unit">m/s</div>
            </div>
            <div class="metric-card">
                <div class="label"> Aceleración</div>
                <div class="value accel" id="accelValue">--</div>
                <div class="unit">m/s²</div>
            </div>
            <div class="metric-card">
                <div class="label"> Vibración</div>
                <div class="value vibration" id="vibValue">--</div>
                <div class="unit">m/s²</div>
            </div>
            <div class="metric-card" style="grid-column: span 1;">
                <div class="label"> GPS</div>
                <div class="value gps" id="gpsValue">--</div>
                <div class="unit" style="font-size:11px;">Lat / Lon</div>
            </div>
        </section>

        <!-- GRÁFICOS (Omitidos para no hacer el código largo, pero aquí van tus canvas) -->
        <section class="charts-row">
            <div class="chart-box">
                <h3> Altitud vs Tiempo</h3>
                <canvas id="altChart"></canvas>
            </div>
            <!-- Los demás gráficos -->
        </section>

        <!-- TABLA DE DATOS HISTÓRICOS -->
        <section class="table-section">
            <h3> Registro de Telemetría <span class="badge" id="rowCount">0 registros</span></h3>
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Altitud (m)</th>
                            <th>Temp (°C)</th>
                            <th>Humedad (%)</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        <!-- Filas dinámicas -->
                    </tbody>
                </table>
            </div>
        </section>
    </div>
    <script src="~/js/site.js"></script>
</body>
</html>